{
  "schemaVersion": 1,
  "id": "overworld_coordinates",
  "version": "${version}",

  "name": "Overworld Coordinates",
  "description": "Shows coordinates in different dimensions in the scale of the overworld, plus the matching nether coordinates while standing in the overworld",
  "authors": [
    "Benonardo"
  ],
  "contact": {
    "sources": "https://github.com/Benonardo/Overworld-Coordinates"
  },

  "license": "MIT",
  "icon": "assets/overworld_coordinates/icon.png",

  "environment": "client",
  "entrypoints": {},
  "mixins": [
    "${mixin_config}"
  ],

  "depends": {
    "fabricloader": "${loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}"
  },
  "recommends": {
    "betterf3": "*"
  }
}
